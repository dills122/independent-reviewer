{
  "$id": "urn:independent-reviewer:schema:review-report-metadata:v1",
  "$comment": "This JSON Schema validates structural constraints only. Contract acceptance also requires versioned semantic validation by the Independent Reviewer runtime or an equivalent implementation.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "snapshotDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "briefDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "guidanceGraphDigest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "SHA256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reportDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1
    },
    "preliminarySchema": {
      "type": "string",
      "minLength": 1
    },
    "finalSchema": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "snapshotDigest",
    "briefDigest",
    "guidanceGraphDigest",
    "reportDigest",
    "promptVersion",
    "preliminarySchema",
    "finalSchema"
  ],
  "additionalProperties": false
}
