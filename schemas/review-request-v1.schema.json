{
  "$id": "urn:independent-reviewer:schema:review-request:v1",
  "$comment": "This JSON Schema validates structural constraints only. Contract acceptance also requires versioned semantic validation by the Independent Reviewer runtime or an equivalent implementation.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "flowId": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128,
      "pattern": "^flow_[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "reviewInstance": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximum": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "number"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "workingTree": {
          "default": {
            "mode": "CUMULATIVE",
            "includeUntracked": true
          },
          "type": "object",
          "properties": {
            "mode": {
              "default": "CUMULATIVE",
              "type": "string",
              "const": "CUMULATIVE"
            },
            "includeUntracked": {
              "default": true,
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "canonicalInputs": {
      "type": "object",
      "properties": {
        "requirements": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 7,
                "maxLength": 128,
                "pattern": "^input_[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "REPOSITORY_FILE"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "INLINE"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "kind": {
                "type": "string",
                "const": "REQUIREMENTS"
              }
            },
            "required": [
              "id",
              "title",
              "content",
              "provenance",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "implementationPlan": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 7,
              "maxLength": 128,
              "pattern": "^input_[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "REPOSITORY_FILE"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "path"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "INLINE"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "label"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "IMPLEMENTATION_PLAN"
            }
          },
          "required": [
            "id",
            "title",
            "content",
            "provenance",
            "kind"
          ],
          "additionalProperties": false
        },
        "projectGuidance": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 7,
                "maxLength": 128,
                "pattern": "^input_[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "REPOSITORY_FILE"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "INLINE"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "kind": {
                "type": "string",
                "const": "PROJECT_GUIDANCE"
              }
            },
            "required": [
              "id",
              "title",
              "content",
              "provenance",
              "kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "requirements",
        "implementationPlan"
      ],
      "additionalProperties": false
    },
    "authorPacket": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "successCriteria": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "planTraceability": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "planItem": {
                "type": "string",
                "minLength": 1
              },
              "implementation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "planItem",
              "implementation"
            ],
            "additionalProperties": false
          }
        },
        "technicalApproach": {
          "type": "string",
          "minLength": 1
        },
        "componentWalkthrough": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "changes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "component",
              "changes"
            ],
            "additionalProperties": false
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "decision",
              "rationale",
              "alternatives"
            ],
            "additionalProperties": false
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claimedVerification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "PASSED",
                  "FAILED",
                  "PARTIAL",
                  "NOT_RUN"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "command",
              "outcome",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "knownGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "challengePoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schemaVersion",
        "intent",
        "successCriteria",
        "planTraceability",
        "technicalApproach",
        "componentWalkthrough",
        "decisions",
        "invariants",
        "claimedVerification",
        "risks",
        "knownGaps",
        "challengePoints"
      ],
      "additionalProperties": false
    },
    "reviewConfigRef": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^config_[A-Za-z0-9][A-Za-z0-9_-]*$"
    }
  },
  "required": [
    "schemaVersion",
    "flowId",
    "reviewInstance",
    "repository",
    "canonicalInputs",
    "reviewConfigRef"
  ],
  "additionalProperties": false
}
