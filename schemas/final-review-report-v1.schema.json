{
  "$id": "urn:independent-reviewer:schema:final-review-report:v1",
  "$comment": "This JSON Schema validates structural constraints only. Contract acceptance also requires versioned semantic validation by the Independent Reviewer runtime or an equivalent implementation.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "stage": {
      "type": "string",
      "const": "FINAL"
    },
    "snapshotDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "briefDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 9,
            "maxLength": 128,
            "pattern": "^finding_[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "detail"
              ],
              "additionalProperties": false
            }
          },
          "correction": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "severity",
          "title",
          "scenario",
          "impact",
          "evidence",
          "correction"
        ],
        "additionalProperties": false
      }
    },
    "preliminaryFindingDispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "preliminaryFindingId": {
            "type": "string",
            "minLength": 9,
            "maxLength": 128,
            "pattern": "^finding_[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "RETAINED",
              "REVISED",
              "WITHDRAWN",
              "MERGED"
            ]
          },
          "finalFindingId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 9,
                "maxLength": 128,
                "pattern": "^finding_[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "preliminaryFindingId",
          "disposition",
          "finalFindingId",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "authorClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "CONTRADICTED",
              "UNVERIFIED"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claim",
          "status",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "READY",
        "READY_WITH_FOLLOW_UPS",
        "NOT_READY",
        "UNABLE_TO_VERIFY"
      ]
    },
    "nextActions": {
      "type": "object",
      "properties": {
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fastFollows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "blockers",
        "fastFollows"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "snapshotDigest",
    "briefDigest",
    "summary",
    "findings",
    "preliminaryFindingDispositions",
    "authorClaims",
    "limitations",
    "verdict",
    "nextActions"
  ],
  "additionalProperties": false
}
