{
  "$id": "urn:independent-reviewer:schema:review-run-config:v2",
  "$comment": "This JSON Schema validates structural constraints only. Contract acceptance also requires versioned semantic validation by the Independent Reviewer runtime or an equivalent implementation.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "configId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^config_[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "providerRouting": {
      "type": "object",
      "properties": {
        "order": {
          "minItems": 2,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          }
        },
        "maxPrice": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "completion": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "request": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "prompt",
            "completion",
            "request"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "order",
        "maxPrice"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "maxInitialEvidenceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxConversationBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxOutputTokensPerCall": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      },
      "required": [
        "maxInitialEvidenceBytes",
        "maxConversationBytes",
        "maxOutputTokensPerCall",
        "maxTotalTokens",
        "timeoutMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "configId",
    "model",
    "providerRouting",
    "budgets"
  ],
  "additionalProperties": false
}
