{
  "$id": "urn:independent-reviewer:schema:finding-verification:v4",
  "$comment": "This JSON Schema validates structural constraints only. Contract acceptance also requires versioned semantic validation by the Independent Reviewer runtime or an equivalent implementation.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 4
    },
    "stage": {
      "type": "string",
      "const": "FINDING_VERIFICATION"
    },
    "snapshotDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "briefDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "assessments": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "preliminaryFindingId": {
            "type": "string",
            "minLength": 9,
            "maxLength": 128,
            "pattern": "^finding_[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "VIOLATION_DEMONSTRATED",
              "NO_VIOLATION",
              "INCONCLUSIVE"
            ]
          },
          "obligationStatus": {
            "type": "string",
            "enum": [
              "APPLICABLE",
              "ABSENT_OR_INAPPLICABLE",
              "UNDETERMINED"
            ]
          },
          "scenarioStatus": {
            "type": "string",
            "enum": [
              "IN_SCOPE",
              "OUT_OF_SCOPE",
              "NO_INPUT_SCENARIO",
              "UNDETERMINED"
            ]
          },
          "behaviorStatus": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "REFUTED",
              "NOT_ESTABLISHED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "preliminaryFindingId",
          "status",
          "obligationStatus",
          "scenarioStatus",
          "behaviorStatus",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "concernAssessments": {
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "EVIDENCE_GAP",
              "LIMITATION"
            ]
          },
          "concernIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "BLOCKING_UNCERTAINTY_DEMONSTRATED",
              "NO_BLOCKING_UNCERTAINTY",
              "INCONCLUSIVE"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "kind",
          "concernIndex",
          "status",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "snapshotDigest",
    "briefDigest",
    "assessments",
    "concernAssessments"
  ],
  "additionalProperties": false
}
