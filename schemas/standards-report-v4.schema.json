{
  "$id": "urn:independent-reviewer:schema:standards-report:v4",
  "$comment": "This JSON Schema validates structural constraints only. Contract acceptance also requires versioned semantic validation by the Independent Reviewer runtime or an equivalent implementation.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 4
    },
    "stage": {
      "type": "string",
      "const": "FINAL"
    },
    "snapshotDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "briefDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "SHA256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 9,
            "maxLength": 128,
            "pattern": "^finding_[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "anchor": {
                      "type": "string",
                      "const": "LINE_RANGE"
                    },
                    "side": {
                      "type": "string",
                      "enum": [
                        "BASE",
                        "HEAD"
                      ]
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "path",
                    "anchor",
                    "side",
                    "startLine",
                    "endLine",
                    "detail"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "anchor": {
                      "type": "string",
                      "const": "SYMBOL"
                    },
                    "side": {
                      "type": "string",
                      "enum": [
                        "BASE",
                        "HEAD"
                      ]
                    },
                    "symbol": {
                      "type": "string",
                      "minLength": 1
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "path",
                    "anchor",
                    "side",
                    "symbol",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "correction": {
            "type": "string",
            "minLength": 1
          },
          "ruleIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 6,
              "maxLength": 128,
              "pattern": "^rule_[A-Za-z0-9][A-Za-z0-9_-]*$"
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "REQUIRED",
              "RECOMMENDED"
            ]
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "claimIds": {
            "minItems": 1,
            "maxItems": 1024,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 7,
              "maxLength": 128,
              "allOf": [
                {
                  "pattern": "^claim_[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                {
                  "pattern": "^claim_[0-9a-f]{64}$"
                }
              ]
            }
          },
          "representativeClaimId": {
            "type": "string",
            "minLength": 7,
            "maxLength": 128,
            "allOf": [
              {
                "pattern": "^claim_[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              {
                "pattern": "^claim_[0-9a-f]{64}$"
              }
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "PRELIMINARY",
              "FINAL_ONLY"
            ]
          },
          "emergenceRationale": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "impact",
          "evidence",
          "correction",
          "ruleIds",
          "severity",
          "problem",
          "claimIds",
          "representativeClaimId",
          "origin",
          "emergenceRationale"
        ],
        "additionalProperties": false
      }
    },
    "preliminaryFindingDispositions": {
      "maxItems": 0,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "preliminaryFindingId": {
            "type": "string",
            "minLength": 9,
            "maxLength": 128,
            "pattern": "^finding_[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "RETAINED",
              "REVISED",
              "WITHDRAWN",
              "MERGED"
            ]
          },
          "finalFindingId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 9,
                "maxLength": 128,
                "pattern": "^finding_[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "preliminaryFindingId",
          "disposition",
          "finalFindingId",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "preliminaryConcernDispositions": {
      "maxItems": 0,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "EVIDENCE_GAP",
              "LIMITATION"
            ]
          },
          "preliminaryConcern": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "RESOLVED",
              "REMAINS"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "preliminaryConcern",
          "disposition",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "authorClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "const": "UNVERIFIED"
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claim",
          "status",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "authorVerificationClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "claimedOutcome": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "PARTIAL",
              "NOT_RUN"
            ]
          },
          "claimedSummary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "const": "UNVERIFIED"
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claimIndex",
          "command",
          "claimedOutcome",
          "claimedSummary",
          "status",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "changedPathCoverage": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "type": "string",
            "enum": [
              "INSPECTED",
              "UNASSESSED",
              "OUT_OF_SCOPE"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "status",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "canonicalInputCoverage": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canonicalInputId": {
            "type": "string",
            "minLength": 7,
            "maxLength": 128,
            "pattern": "^input_[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ASSESSED",
              "UNASSESSED"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "canonicalInputId",
          "status",
          "explanation"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "READY",
        "READY_WITH_FOLLOW_UPS",
        "NOT_READY",
        "UNABLE_TO_VERIFY"
      ]
    },
    "nextActions": {
      "type": "object",
      "properties": {
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fastFollows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "blockers",
        "fastFollows"
      ],
      "additionalProperties": false
    },
    "authorContext": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "PROVIDED"
                },
                "digest": {
                  "type": "object",
                  "properties": {
                    "algorithm": {
                      "type": "string",
                      "const": "SHA256"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "algorithm",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "noteCode": {
                  "type": "null"
                }
              },
              "required": [
                "status",
                "digest",
                "noteCode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "DECLINED"
                },
                "digest": {
                  "type": "object",
                  "properties": {
                    "algorithm": {
                      "type": "string",
                      "const": "SHA256"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "algorithm",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "noteCode": {
                  "type": "string",
                  "const": "AUTHOR_CONTEXT_DECLINED"
                }
              },
              "required": [
                "status",
                "digest",
                "noteCode"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "projection": {
      "type": "object",
      "properties": {
        "policyVersion": {
          "type": "string",
          "const": "claim-projection-v1"
        },
        "priorClaimSetDigest": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "SHA256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        "priorVerificationDigest": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "SHA256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        "candidateDigest": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "SHA256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        "transitionDigest": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "SHA256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        "finalVerificationDigest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "algorithm": {
                  "type": "string",
                  "const": "SHA256"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "algorithm",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "policyVersion",
        "priorClaimSetDigest",
        "priorVerificationDigest",
        "candidateDigest",
        "transitionDigest",
        "finalVerificationDigest"
      ],
      "additionalProperties": false
    },
    "uncertainties": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimId": {
            "type": "string",
            "minLength": 7,
            "maxLength": 128,
            "allOf": [
              {
                "pattern": "^claim_[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              {
                "pattern": "^claim_[0-9a-f]{64}$"
              }
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claimId",
          "blocking",
          "assertion"
        ],
        "additionalProperties": false
      }
    },
    "mode": {
      "type": "string",
      "const": "STANDARDS"
    },
    "ruleAssessments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 6,
            "maxLength": 128,
            "pattern": "^rule_[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ASSESSED",
              "CONFLICT",
              "UNASSESSED"
            ]
          },
          "conflictingRuleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 6,
              "maxLength": 128,
              "pattern": "^rule_[A-Za-z0-9][A-Za-z0-9_-]*$"
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ruleId",
          "status",
          "conflictingRuleIds",
          "explanation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "snapshotDigest",
    "briefDigest",
    "summary",
    "findings",
    "preliminaryFindingDispositions",
    "preliminaryConcernDispositions",
    "authorClaims",
    "authorVerificationClaims",
    "changedPathCoverage",
    "canonicalInputCoverage",
    "limitations",
    "verdict",
    "nextActions",
    "authorContext",
    "projection",
    "uncertainties",
    "mode",
    "ruleAssessments"
  ],
  "additionalProperties": false
}
